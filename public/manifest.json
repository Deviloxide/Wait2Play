{
  "manifest_version": 3,
  "name": "Wait2Play",
  "short_name": "Wait2Play",
  "version": "1.0.0",
  "description": "Shows a 90-day Giveaway & Bundle Risk Score and a sale verdict on Steam, GOG, Epic, Humble, GG.deals, and IsThereAnyDeal.",
  "homepage_url": "https://github.com/Deviloxide/Wait2Play",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Wait2Play",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.cheapshark.com/*",
    "https://store.steampowered.com/*",
    "https://api.steampowered.com/*",
    "https://store-site-backend-static.ak.epicgames.com/*",
    "https://raw.githubusercontent.com/*",
    "https://www.gamerpower.com/*",
    "https://www.reddit.com/*",
    "https://isthereanydeal.com/*",
    "https://www.gog.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://store.steampowered.com/*",
        "https://www.gog.com/*",
        "https://store.epicgames.com/*",
        "https://www.humblebundle.com/store*",
        "https://gg.deals/*",
        "https://isthereanydeal.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
